/* autoexec for t004_master_profile_merge
 * Materialises the four inputs the original 04_sas_data_products.sas reads to
 * build the CUSTOMER_MASTER_PROFILE golden record:
 *   BASE     <- STG_CUSTOMER_360       (active customers)
 *   SEGMENTS <- DPDB.CUSTOMER_SEGMENTS
 *   TXN      <- DPDB.TRANSACTION_ANALYTICS
 *   RISK     <- DPDB.CUSTOMER_RISK_SCORES
 * Rows are a sample of the repo's own data/03_sas_data_products/*.csv (and the
 * customer_360 staging extract). SEGMENTS/TXN/RISK deliberately cover only a
 * subset of BASE so the merge's IN= default-handling branches are exercised.
 * The 4-way MERGE and completeness reporting in script.sas are the author's,
 * unchanged.
 */
options obs=100;

data BASE;
